{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadGlobalModel",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::fl-heart-disease-aps2",
        "arn:aws:s3:::fl-heart-disease-aps2/global/*"
      ]
    },
    {
      "Sid": "ReadRoundsMetadata",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Scan"],
      "Resource": "arn:aws:dynamodb:*:*:table/FlRoundsTable"
    }
  ]
}
