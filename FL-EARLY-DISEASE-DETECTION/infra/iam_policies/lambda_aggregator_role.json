{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteAllObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::fl-heart-disease-aps2",
        "arn:aws:s3:::fl-heart-disease-aps2/*"
      ]
    },
    {
      "Sid": "RoundsAndCountersTableAccess",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Scan"],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/FlRoundsTable",
        "arn:aws:dynamodb:*:*:table/FlUploadCountersTable"
      ]
    }
  ]
}
